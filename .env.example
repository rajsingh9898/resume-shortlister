# ------------------------------------------------------------------------------
# TalentAI Environment Variables Example File
# Copy this file to .env (or .env.development / .env.staging / .env.production)
# and adjust the values according to your environment.
# ------------------------------------------------------------------------------

# Environment Profile: development, staging, production
ENVIRONMENT=development

# Database Connection URL (PostgreSQL or SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talentai

# Redis Server URL (Celery broker and FastAPI cache backend)
REDIS_URL=redis://localhost:6379/0

# JWT Auth Secret Key (Use a strong random alphanumeric string in production)
SECRET_KEY=iridescent_unicorn_silver_secret_token_key_123456789

# Symmetric rest encryption key (Optional. Auto-generated on-disk if omitted)
# ENCRYPTION_KEY=your_fernet_key_here

# Sentry DSN for Error/Exception Monitoring (Optional)
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/123456
